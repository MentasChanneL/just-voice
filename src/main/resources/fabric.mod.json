{
  "schemaVersion": 1,
  "id": "justvoice",
  "version": "${version}",
  "name": "Just Voice",
  "icon": "assets/justvoice/textures/icon.png",
  "description": "Мод для общения в голосовом чате, мирах JustMC Creative+. В мир необходимо установить дополнительный модуль _2M3V_/justvoice",
  "authors": [
    "ChatGPT",
    "2M3V",
    "Falanta"
  ],
  "contact": {
    "sources": "https://github.com/MentasChanneL/just-voice",
    "issues": "https://github.com/MentasChanneL/just-voice/issues"
  },
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.mentaschannel.justvoice.JustVoiceClient"
    ],
    "modmenu": [
      "dev.mentaschannel.justvoice.client.gui.ModMenuIntegration"
    ]
  },
  "depends": {
    "fabricloader": ">=0.20.1",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  },
  "suggests": {
    "modmenu": "*"
  },
  "mixins": [
    "justvoice.client.mixins.json"
  ]
